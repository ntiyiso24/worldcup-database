psql --username=freecodecamp --dbname=postgres -c "CREATE DATABASE worldcup"
psql --username=freecodecamp --dbname=worldcup -c "CREATE TABLE teams (team_id SERIAL PRIMARY KEY, name VARCHAR UNIQUE NOT NULL); CREATE TABLE games (game_id SERIAL PRIMARY KEY, year INT NOT NULL, round VARCHAR NOT NULL, winner_id INT NOT NULL, opponent_id INT NOT NULL, winner_goals INT NOT NULL, opponent_goals INT NOT NULL, FOREIGN KEY (winner_id) REFERENCES teams(team_id), FOREIGN KEY (opponent_id) REFERENCES teams(team_id))"
chmod +x /workspace/project/insert_data.sh
cd /workspace/project
cd /workspace/project
psql --username=freecodecamp --dbname=worldcup -c "SELECT COUNT(*) FROM teams"
psql --username=freecodecamp --dbname=worldcup -c "SELECT COUNT(*) FROM games"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT SUM(winner_goals + opponent_goals) FROM games"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT AVG(winner_goals) FROM games"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT ROUND(AVG(winner_goals), 2) FROM games"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT AVG(winner_goals + opponent_goals) FROM games"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT MAX(GREATEST(winner_goals, opponent_goals)) FROM games"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT COUNT(*) FROM games WHERE winner_goals > 2"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT name FROM teams WHERE team_id = (SELECT winner_id FROM games WHERE year = 2018 AND round = 'Final')"
psql --username=freecodecamp --dbname=worldcup -t --no-align -c "SELECT DISTINCT name FROM teams WHERE team_id IN (SELECT winner_id FROM games WHERE year = 2014 AND round = 'Eighth-Final' UNION SELECT opponent_id FROM games WHERE year = 2014 AND round = 'Eighth-Final') ORDER BY name"
cd /workspace/project
q
chmod +x /workspace/project/queries.sh
cd /workspace/project
cd /workspace/project
